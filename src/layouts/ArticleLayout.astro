---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import ArticleResources from '../components/ArticleResources.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';
import { TAGS, tagHref } from '../data/tags';

interface Crumb {
  readonly label: string;
  readonly href: string;
}

interface Props {
  readonly title: string;
  /** A literal phrase to emphasize visually, with plain metadata retained. */
  readonly titleEmphasis?: string | undefined;
  readonly description: string;
  readonly datePublished: Date;
  readonly dateModified?: Date | undefined;
  readonly tags: readonly string[];
  readonly crumbs: readonly Crumb[];
  /** Resolved hero image, when the entry names one. */
  readonly hero?: ImageMetadata | undefined;
  readonly audio?: string | undefined;
  readonly youtube?: string | undefined;
  readonly youtubeLabel?: string | undefined;
  readonly additionalVideos?: readonly {
    readonly label: string;
    readonly url: string;
    readonly context?: string | undefined;
  }[] | undefined;
  readonly repositories?: readonly {
    readonly label: string;
    readonly url: string;
    readonly context?: string | undefined;
  }[] | undefined;
  readonly status?: string | undefined;
  /** Evergreen pages show "updated" prominently; dated posts lead with published. */
  readonly evergreen?: boolean;
  /** Path of the raw markdown twin. */
  readonly markdownHref: string;
  readonly schemaType?: 'BlogPosting' | 'TechArticle' | undefined;
  readonly seed: string;
  /** Headings from the rendered entry, for the "On this page" list. */
  readonly headings?: readonly MarkdownHeading[] | undefined;
}

const {
  title, titleEmphasis, description, datePublished, dateModified, tags, crumbs,
  hero, audio, youtube, youtubeLabel, additionalVideos, repositories, status, evergreen = false, markdownHref, seed,
  schemaType = 'TechArticle', headings = [],
} = Astro.props;

const emphasisIndex = titleEmphasis === undefined ? -1 : title.indexOf(titleEmphasis);
if (titleEmphasis !== undefined && emphasisIndex === -1) {
  throw new Error(`Title emphasis must be a phrase in the title: ${title}`);
}
const titleBeforeEmphasis = title.slice(0, emphasisIndex);
const titleAfterEmphasis = title.slice(emphasisIndex + (titleEmphasis?.length ?? 0));

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', timeZone: 'UTC' });

// Widened to string keys: the article's tags are validated by the content
// schema, so they are known-good, but they arrive typed as plain strings.
const tagsBySlug = new Map<string, (typeof TAGS)[number]>(
  TAGS.map((tag) => [tag.slug, tag]),
);

const site = Astro.site ?? new URL('https://matlus.com');
const canonical = new URL(Astro.url.pathname, site);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: title,
  description,
  datePublished: datePublished.toISOString(),
  dateModified: (dateModified ?? datePublished).toISOString(),
  author: { '@type': 'Person', name: 'Shiv Kumar', url: site.href },
  url: canonical.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
  inLanguage: 'en',
  keywords: tags.map((slug) => tagsBySlug.get(slug)?.label ?? slug).join(', '),
  ...(hero ? { image: new URL(hero.src, site).href } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: new URL(crumb.href, site).href,
  })),
};
---

<BaseLayout title={`${title} | Shiv Kumar`} description={description} markdownHref={markdownHref}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <div class="page article-page" data-article={seed}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {crumbs.map((crumb) => <li><a href={crumb.href}>{crumb.label}</a></li>)}
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header class="article-head">
      {
        hero
          ? <Image src={hero} alt="" class="article-head__hero" widths={[640, 1024, 1600]} sizes="(max-width: 72rem) 100vw, 72rem" loading="eager" />
          : <PlaceholderImage seed={seed} ratio="wide" label="" />
      }

      <div class="article-head__text prose">
        <h1>{titleEmphasis === undefined ? title : <>{titleBeforeEmphasis}<em class="gradient-text">{titleEmphasis}</em>{titleAfterEmphasis}</>}</h1>
        <p class="article-head__lede">{description}</p>

        <p class="article-head__meta">
          {
            dateModified && (evergreen || dateModified.getTime() > datePublished.getTime())
              ? <>Published {fmt(datePublished)} · Updated {fmt(dateModified)}</>
              : <>Published {fmt(datePublished)}</>
          }
          {status === 'exploratory' && <span class="badge">Exploratory</span>}
        </p>

        <ul class="article-head__tags" aria-label="Topics">
          {
            tags.map((slug) => (
              <li>
                <a href={tagHref(slug)}>{tagsBySlug.get(slug)?.label ?? slug}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <div class="article-body">
      <article class="prose">
        <slot />
        <ArticleResources youtube={youtube} youtubeLabel={youtubeLabel} additionalVideos={additionalVideos} audio={audio} repositories={repositories} />
      </article>

      <aside class="article-side">
        <TableOfContents headings={headings} />

        <section>
          <h2 class="side-heading">Read as markdown</h2>
          <p class="side-note">
            Clean article text with no navigation or sidebar, for machines and for
            quoting.
          </p>
          <p><a href={markdownHref}>{markdownHref}</a></p>
        </section>
      </aside>
    </div>
  </div>

</BaseLayout>

<style>
  .crumbs {
    margin: var(--space-m) 0 var(--space-s);
    font-size: var(--step--1);
  }

  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    padding: 0;
    margin: 0;
    color: var(--color-text-faint);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: var(--space-3xs);
    color: var(--color-text-faint);
  }

  .crumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .crumbs a:hover { color: var(--color-accent); text-decoration: underline; }

  .article-head__hero {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .article-head__text { margin-top: var(--space-l); }

  .article-head__lede {
    font-size: var(--step-1);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .article-head__meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    flex-wrap: wrap;
    margin: 0;
    padding: var(--space-3xs) var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .article-head__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-s) 0 0;
    padding: 0;
  }

  .article-head__tags a {
    display: inline-block;
    padding: 0.15rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 999px;
    background: var(--color-accent-wash);
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .article-head__tags a:hover {
    border-color: var(--color-accent);
  }

  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.1rem 0.4rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: 999px;
  }

  /* The diagram and prose share a wider column on desktop. */
  .article-page {
    width: min(100% - (var(--gutter) * 2), var(--width-article));
    max-width: var(--width-article);
  }

  .article-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    gap: var(--space-xl);
    margin-top: var(--space-xl);
    align-items: start;
  }

  .article-body > .prose {
    max-width: none;
    min-width: 0;
  }

  /* The two quoted prompts read as text, so their fenced blocks wrap on phones. */
  .article-page[data-article="verified-not-trusted-expense-analysis-part-one"] :global(#the-standard-prompt + pre),
  .article-page[data-article="verified-not-trusted-expense-analysis-part-one"] :global(#the-more-precise-prompt + .article-callout + pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .article-page[data-article="verified-not-trusted-expense-analysis-part-one"] :global(.expense-example-output) {
    margin: var(--space-m) 0;
    padding: var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-sunken);
  }

  .article-page[data-article="verified-not-trusted-expense-analysis-part-one"] :global(.expense-example-output > summary) {
    cursor: pointer;
    font-weight: 600;
    overflow-wrap: break-word;
  }

  .article-page[data-article="verified-not-trusted-expense-analysis-part-one"] :global(.expense-example-output[open] > summary) {
    margin-bottom: var(--space-s);
  }

  .article-side {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-s));
    font-size: var(--step--1);
    display: grid;
    gap: var(--space-l);
    /* A long list scrolls inside the sidebar instead of running off screen. */
    max-height: calc(100vh - var(--nav-height) - var(--space-l));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .side-heading {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
    margin-bottom: var(--space-2xs);
  }

  .side-note { margin: var(--space-2xs) 0 0; color: var(--color-text-faint); }

  @media (max-width: 60rem) {
    /* minmax(0, 1fr), never a bare 1fr: the bare form has an `auto` minimum
       and lets wide content push the page past the viewport. */
    .article-body { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .article-side { position: static; max-height: none; overflow: visible; }
  }
</style>
