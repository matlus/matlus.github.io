---
import type { NavIconName } from '../data/nav';

interface Props {
  readonly name: NavIconName;
}

/** Stroke paths on a 24-unit grid. One drawing style across the set. */
const PATHS: Record<NavIconName, readonly string[]> = {
  layers: ['M12 3 3 8l9 5 9-5-9-5Z', 'm3 12.5 9 5 9-5', 'm3 17 9 5 9-5'],
  code: ['m8 7-5 5 5 5', 'm16 7 5 5-5 5', 'm14 4-4 16'],
  shield: ['M12 3 4.5 6v5.5c0 4.5 3 8 7.5 9.5 4.5-1.5 7.5-5 7.5-9.5V6L12 3Z', 'm8.5 12 2.5 2.5 4.5-5'],
  alert: ['M12 3.5 2.8 19.5h18.4L12 3.5Z', 'M12 10v4.5', 'M12 17.2v.1'],
  grid: ['M4 4h7v7H4z', 'M13 4h7v7h-7z', 'M4 13h7v7H4z', 'M13 13h7v7h-7z'],
  flask: ['M9.5 3h5', 'M10.5 3v6L5 19a1.5 1.5 0 0 0 1.3 2.2h11.4A1.5 1.5 0 0 0 19 19l-5.5-10V3', 'M7.5 15h9'],
  file: ['M6 3h8l4 4v14H6V3Z', 'M14 3v4h4', 'M9 12h6', 'M9 16h6'],
  play: ['M8 5.5v13l11-6.5-11-6.5Z'],
  user: ['M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z', 'M4.5 20.5a7.5 7.5 0 0 1 15 0'],
};

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
