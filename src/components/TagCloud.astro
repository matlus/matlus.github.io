---
import { TAGS } from '../data/tags';
import { tagCounts } from '../lib/tag-counts';

interface Props {
  readonly heading?: string;
}

const { heading = 'Browse by topic' } = Astro.props;
const weights = await tagCounts();

const sized = TAGS.map((tag) => {
  const weight = weights[tag.slug] ?? 0;
  const step = weight >= 12 ? 4 : weight >= 7 ? 3 : weight >= 3 ? 2 : 1;
  return { ...tag, weight, step };
});
---

<aside class="tag-cloud" aria-labelledby="tag-cloud-heading">
  <h2 class="tag-cloud__heading" id="tag-cloud-heading">{heading}</h2>

  <ul class="tag-cloud__list">
    {
      sized.map((tag) => (
        <li>
          <a
            href={`/tags/${tag.slug}/`}
            class="tag-cloud__tag"
            data-step={tag.step}
            title={tag.description}
          >
            {tag.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="tag-cloud__all">
    <a href="/tags/">All topics</a>
  </p>
</aside>

<style>
  .tag-cloud {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
  }

  .tag-cloud__heading {
    font-size: var(--step-0);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
    margin-bottom: var(--space-s);
  }

  .tag-cloud__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    align-items: baseline;
  }

  .tag-cloud__tag {
    display: inline-block;
    text-decoration: none;
    color: var(--color-text-muted);
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius);
    line-height: 1.3;
  }

  .tag-cloud__tag:hover {
    color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .tag-cloud__tag[data-step='1'] {
    font-size: var(--step--1);
  }
  .tag-cloud__tag[data-step='2'] {
    font-size: var(--step-0);
  }
  .tag-cloud__tag[data-step='3'] {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .tag-cloud__tag[data-step='4'] {
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--color-text);
  }

  .tag-cloud__all {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
  }
</style>
