---
import type { Language, Topic } from '../data/topics';

interface Props {
  readonly topics: readonly Topic[];
  readonly basePath: string;
  /**
   * Topic slugs that have at least one published chapter. Topics without a
   * chapter or a published teaching article are rendered as plain text to
   * avoid linking to an unconverted topic's missing route.
   */
  readonly published: ReadonlySet<string>;
  /** Published teaching articles that cover a topic before its chapter exists. */
  readonly articleLinks?: ReadonlyMap<string, string>;
}

const { topics, basePath, published, articleLinks = new Map<string, string>() } = Astro.props;

/**
 * Typed as a full Record, so adding a language to the union fails the build
 * here until it has a label. The chips name languages and never count them.
 */
const LANGUAGE_LABEL: Record<Language, string> = {
  python: 'Python',
  csharp: 'C#',
  sql: 'SQL',
};
---

<ul class="topics">
  {
    topics.map((topic) => (
      <li class="topics__item">
        {published.has(topic.slug) || articleLinks.has(topic.slug) ? (
          <a href={articleLinks.get(topic.slug) ?? `${basePath}${topic.slug}/`} class="topics__link">
            {topic.title}
          </a>
        ) : (
          <span class="topics__link topics__link--pending">{topic.title}</span>
        )}

        <span class="topics__meta">
          {topic.examples.map((language) => (
            <span class="chip" data-language={language}>
              {LANGUAGE_LABEL[language]}
            </span>
          ))}

          {topic.scope === 'language-independent' && (
            <span class="chip chip--note">Language-independent</span>
          )}

          {!published.has(topic.slug) && !articleLinks.has(topic.slug) && <span class="chip chip--pending">Not yet published</span>}
        </span>

        {topic.note && <p class="topics__note">{topic.note}</p>}
      </li>
    ))
  }
</ul>

<style>
  .topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  /* Each topic is a rounded box; the title link stretches to cover it. */
  .topics__item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .topics__item:has(a.topics__link):hover,
  .topics__item:has(a.topics__link:focus-visible) {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .topics__link {
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
  }

  a.topics__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .topics__item:hover a.topics__link {
    color: var(--color-accent);
  }

  .topics__meta {
    display: flex;
    gap: var(--space-3xs);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .topics__note {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--step--1);
    color: var(--color-text-faint);
    max-width: var(--measure);
  }

  .chip {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .chip--note {
    border-style: dashed;
    color: var(--color-text-faint);
  }

  .chip--pending {
    border-style: dotted;
    color: var(--color-text-faint);
  }

  .topics__link--pending {
    color: var(--color-text-faint);
    font-weight: 400;
  }

  @media (max-width: 560px) {
    .topics__item {
      grid-template-columns: 1fr;
    }

    .topics__meta {
      justify-content: flex-start;
    }
  }
</style>
