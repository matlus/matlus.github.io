---
interface LinkedResource {
  readonly label: string;
  readonly url: string;
  readonly context?: string | undefined;
}

interface Props {
  readonly youtube?: string | undefined;
  readonly youtubeLabel?: string | undefined;
  readonly additionalVideos?: readonly LinkedResource[] | undefined;
  readonly audio?: string | undefined;
  readonly repositories?: readonly LinkedResource[] | undefined;
}

const { youtube, youtubeLabel = 'Watch on YouTube', additionalVideos = [], audio, repositories = [] } = Astro.props;
---

{
  (youtube || additionalVideos.length > 0 || audio || repositories.length > 0) && (
    <aside class="article-resources" aria-labelledby="article-resources-heading">
      <h2 id="article-resources-heading">Keep exploring</h2>
      <div class="article-resources__grid">
        {youtube && (
          <a class="article-resource" href={youtube} target="_blank" rel="noopener noreferrer">
            <svg class="article-resource__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <rect x="2" y="6" width="28" height="20" rx="6" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="m13 11 9 5-9 5z" fill="currentColor" />
            </svg>
            <span>
              <span class="article-resource__kind">Video</span>
              <strong>{youtubeLabel}</strong>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </span>
            <span class="article-resource__arrow" aria-hidden="true">↗</span>
          </a>
        )}

        {additionalVideos.map((video) => (
          <a class="article-resource" href={video.url} target="_blank" rel="noopener noreferrer">
            <svg class="article-resource__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <rect x="2" y="6" width="28" height="20" rx="6" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="m13 11 9 5-9 5z" fill="currentColor" />
            </svg>
            <span>
              <span class="article-resource__kind">Video</span>
              <strong>{video.label}</strong>
              {video.context && <span class="article-resource__context">{video.context}</span>}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </span>
            <span class="article-resource__arrow" aria-hidden="true">↗</span>
          </a>
        ))}

        {repositories.map((repository) => (
          <a class="article-resource" href={repository.url} target="_blank" rel="noopener noreferrer">
            {/* GitHub mark from Simple Icons (CC0), shared with the site footer. */}
            <svg class="article-resource__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
            <span>
              <span class="article-resource__kind">GitHub repository</span>
              <strong>{repository.label}</strong>
              {repository.context && <span class="article-resource__context">{repository.context}</span>}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </span>
            <span class="article-resource__arrow" aria-hidden="true">↗</span>
          </a>
        ))}

        {audio && (
          <div class="article-resource article-resource--audio">
            <span>
              <span class="article-resource__kind">Audio</span>
              <strong>Listen to this article</strong>
              <audio controls preload="none" src={audio}></audio>
              <a href={audio} download>Download audio</a>
            </span>
          </div>
        )}
      </div>
    </aside>
  )
}

<style>
  .article-resources {
    margin-top: var(--space-xl);
    padding: var(--space-l);
    background: var(--color-accent-wash);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .article-resources h2 {
    margin: 0 0 var(--space-m);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    color: var(--color-text);
  }

  .article-resources__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-s);
  }

  .article-resource {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-xs);
    min-width: 0;
    padding: var(--space-s);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
  }

  a.article-resource:hover,
  a.article-resource:focus-visible {
    border-color: var(--color-accent);
    outline-color: var(--color-accent);
  }

  .article-resource__icon {
    width: 2rem;
    height: 2rem;
    color: var(--color-accent);
  }

  .article-resource__kind,
  .article-resource__context {
    display: block;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .article-resource__kind { margin-bottom: var(--space-3xs); }
  .article-resource strong {
    display: block;
    overflow-wrap: anywhere;
    font-size: var(--step-0);
    line-height: 1.3;
  }
  .article-resource__context { margin-top: var(--space-3xs); }
  .article-resource__arrow { color: var(--color-accent); }

  .article-resource--audio { display: block; }
  .article-resource audio { display: block; max-width: 100%; margin-top: var(--space-xs); }
  .article-resource--audio a { display: inline-block; margin-top: var(--space-xs); }

  @media (max-width: 40rem) {
    .article-resources { padding: var(--space-s); }
  }
</style>
