---
import { NAV, isCurrent } from '../data/nav';
import { getCollection } from 'astro:content';

interface Props {
  readonly pathname: string;
}

const { pathname } = Astro.props;
const publishedTopics = new Set(
  (await getCollection('chapters', ({ data }) => !data.draft)).map((chapter) => chapter.data.topic),
);
const nav = NAV.map((item) => ({
  ...item,
  children: item.href === '/acceptance-testing/'
    ? item.children?.filter((child) => publishedTopics.has(child.href.split('/')[2] ?? ''))
    : item.children,
}));
---

<nav class="site-nav" aria-label="Primary">
  <div class="page site-nav__inner">
    <a class="site-nav__brand" href="/">
      <img class="site-nav__mark" src="/matlus-logo.svg?v=readable" alt="" width="56" height="47" />
      <span class="site-nav__identity">
        <span class="site-nav__wordmark">Matlus</span>
        <span class="site-nav__tagline"><strong>Engineering</strong> with <strong>Intent</strong></span>
      </span>
    </a>

    <a class="site-nav__search" href="/search/" aria-label="Search the site" title="Search">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="m15.5 15.5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </a>

    <button
      class="site-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-menu"
    >
      <span class="visually-hidden">Menu</span>
      <span class="site-nav__bars" aria-hidden="true"></span>
    </button>

    <ul class="site-nav__list" id="site-nav-menu">
      {
        nav.map((item) => (
          <li class:list={['site-nav__item', { 'has-children': item.children?.length }]}>
            <a
              href={item.href}
              class="site-nav__link"
              aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
            >
              {item.label}
            </a>

            {item.children && item.children.length > 0 && (
              <>
                <button
                  class="site-nav__caret"
                  type="button"
                  aria-expanded="false"
                  aria-label={`Open ${item.label} menu`}
                >
                  <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true">
                    <path
                      d="M1 1.5 6 6.5 11 1.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>

                <ul class="site-nav__panel">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href}>
                        <span class="site-nav__panel-label">{child.label}</span>
                        {child.blurb && (
                          <span class="site-nav__panel-blurb">{child.blurb}</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  @font-face {
    font-family: 'SK Porsche';
    src: url('/fonts/sk-porsche.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: var(--nav-height);
  }

  .site-nav__search {
    order: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    color: var(--color-text-muted);
  }

  .site-nav__search:hover {
    color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .site-nav__identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .site-nav__wordmark {
    font-family: 'SK Porsche', var(--font-sans);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .site-nav__tagline {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.125;
    letter-spacing: 0;
    color: var(--color-text-muted);
    text-align-last: justify;
    white-space: nowrap;
  }

  .site-nav__tagline strong {
    font-weight: 700;
    color: var(--color-text);
  }

  .site-nav__mark {
    display: block;
    width: 3.5rem;
    height: auto;
    flex: none;
  }

  .site-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0 0 0 auto;
    padding: 0;
  }

  .site-nav__item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .site-nav__link {
    display: block;
    padding: var(--space-2xs) var(--space-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .site-nav__link:hover {
    color: var(--color-text);
    background: var(--color-surface-sunken);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
  }

  .site-nav__caret {
    background: none;
    border: 0;
    padding: var(--space-3xs);
    margin-left: calc(var(--space-3xs) * -1);
    color: var(--color-text-faint);
    cursor: pointer;
    display: flex;
    align-items: center;
    border-radius: var(--radius);
  }

  .site-nav__caret:hover {
    color: var(--color-text);
  }

  /*
   * The panel is in the DOM at page load and hidden with CSS. Crawlers and
   * assistive tech see the links; only visibility is conditional.
   */
  .site-nav__panel {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 17rem;
    list-style: none;
    margin: 0;
    padding: var(--space-2xs);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.14s ease,
      transform 0.14s ease,
      visibility 0.14s;
  }

  .site-nav__item:hover .site-nav__panel,
  .site-nav__item:focus-within .site-nav__panel,
  .site-nav__item.is-open .site-nav__panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-nav__panel a {
    display: block;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
  }

  .site-nav__panel a:hover {
    background: var(--color-accent-wash);
  }

  .site-nav__panel-label {
    display: block;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .site-nav__panel-blurb {
    display: block;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .site-nav__toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    padding: var(--space-2xs) var(--space-xs);
    cursor: pointer;
    color: var(--color-text);
    order: 3;
  }

  .site-nav__bars,
  .site-nav__bars::before,
  .site-nav__bars::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .site-nav__bars {
    position: relative;
  }

  .site-nav__bars::before,
  .site-nav__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-nav__bars::before {
    top: -6px;
  }
  .site-nav__bars::after {
    top: 6px;
  }

  /* ------------------------------------------------------------- mobile */

  @media (max-width: 1023px) {
    .site-nav__toggle {
      display: block;
      margin-left: 0;
    }

    .site-nav__search {
      margin-left: auto;
    }

    .site-nav__list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-2xs) var(--gutter) var(--space-s);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      max-height: calc(100vh - var(--nav-height));
      overflow-y: auto;
    }

    .site-nav__list.is-open {
      display: flex;
    }

    .site-nav__item {
      flex-wrap: wrap;
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav__link {
      flex: 1;
      font-size: var(--step-0);
      padding: var(--space-xs) 0;
    }

    .site-nav__caret {
      padding: var(--space-xs);
    }

    .site-nav__panel {
      position: static;
      width: 100%;
      border: 0;
      box-shadow: none;
      background: none;
      padding: 0 0 var(--space-2xs) var(--space-s);
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .site-nav__item.is-open .site-nav__panel {
      display: block;
    }

    /* Hover must not open accordions on touch. */
    .site-nav__item:hover .site-nav__panel,
    .site-nav__item:focus-within .site-nav__panel {
      display: none;
    }

    .site-nav__item.is-open:hover .site-nav__panel,
    .site-nav__item.is-open:focus-within .site-nav__panel {
      display: block;
    }
  }

  @media (max-width: 479px) {
    .site-nav__inner {
      gap: var(--space-2xs);
    }

    .site-nav__mark {
      width: 2.5rem;
    }

    .site-nav__brand {
      gap: var(--space-3xs);
    }

    .site-nav__wordmark {
      font-size: var(--step-0);
    }

    .site-nav__identity {
      gap: calc(var(--space-3xs) / 2);
    }

    .site-nav__tagline {
      font-size: 0.8125rem;
      line-height: 1;
    }

    .site-nav__search {
      width: 2rem;
      flex: none;
    }

    .site-nav__toggle {
      flex: none;
      width: 2rem;
      padding: var(--space-3xs);
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');

  if (nav) {
    const toggle = nav.querySelector<HTMLButtonElement>('.site-nav__toggle');
    const list = nav.querySelector<HTMLUListElement>('.site-nav__list');

    toggle?.addEventListener('click', () => {
      const open = list?.classList.toggle('is-open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });

    for (const caret of nav.querySelectorAll<HTMLButtonElement>('.site-nav__caret')) {
      caret.addEventListener('click', (event) => {
        event.preventDefault();
        const item = caret.closest<HTMLElement>('.site-nav__item');
        if (!item) return;

        const open = item.classList.toggle('is-open');
        caret.setAttribute('aria-expanded', String(open));
      });
    }

    // Escape closes whatever is open.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      list?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');

      for (const item of nav.querySelectorAll<HTMLElement>('.site-nav__item.is-open')) {
        item.classList.remove('is-open');
        item
          .querySelector<HTMLButtonElement>('.site-nav__caret')
          ?.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
