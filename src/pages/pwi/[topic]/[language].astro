---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { TOPICS } from '../../../data/topics';
import { PILLAR_COPY } from '../../../data/pillars';

/**
 * A chapter, at /pwi/<topic>/<language>/.
 *
 * Chapters are evergreen reference rather than dated posts, so the layout
 * leads with the updated date. Breadcrumbs climb through the pillar and the
 * topic hub, which is what gives a reader arriving cold from search somewhere
 * to go next.
 */

const LANGUAGE_LABEL: Record<string, string> = {
  python: 'Python',
  csharp: 'C#',
  sql: 'SQL',
};

export const getStaticPaths = (async () => {
  const chapters = await getCollection('chapters', ({ data }) => !data.draft && data.section === 'pwi');

  return chapters.map((chapter) => ({
    params: { topic: chapter.data.topic, language: chapter.data.language ?? 'shared' },
    props: { chapter },
  }));
}) satisfies GetStaticPaths;

const { chapter } = Astro.props;
const { Content } = await render(chapter);

const topic = TOPICS.find((t) => t.slug === chapter.data.topic);
const pillarSlug = topic?.pillar;
const pillar = pillarSlug && pillarSlug in PILLAR_COPY
  ? PILLAR_COPY[pillarSlug as keyof typeof PILLAR_COPY]
  : undefined;

const languageLabel = LANGUAGE_LABEL[chapter.data.language ?? ''] ?? chapter.data.language ?? '';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'PWI', href: '/pwi/' },
  ...(pillar && pillarSlug ? [{ label: pillar.title, href: `/pwi/${pillarSlug}/` }] : []),
  { label: topic?.title ?? chapter.data.topic, href: `/pwi/${chapter.data.topic}/` },
];
---

<ArticleLayout
  title={`${chapter.data.title} in ${languageLabel}`}
  description={chapter.data.description}
  datePublished={chapter.data.datePublished}
  dateModified={chapter.data.dateModified}
  tags={chapter.data.tags}
  crumbs={crumbs}
  audio={chapter.data.audio}
  youtube={chapter.data.youtube}
  evergreen={true}
  markdownHref={`/pwi/${chapter.data.topic}/${chapter.data.language}.md`}
  seed={`${chapter.data.topic}-${chapter.data.language}`}
>
  <Content />
</ArticleLayout>
