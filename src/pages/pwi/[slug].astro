---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SectionLayout from '../../layouts/SectionLayout.astro';
import TopicList from '../../components/TopicList.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { TOPICS } from '../../data/topics';
import { PILLAR_COPY } from '../../data/pillars';
import { heroFor } from '../../lib/heroes';
import { loadPwiArticleTopics, loadPwiPillarArticles, loadTopicCards, publishedTopicsFirst } from '../../lib/pwi-topic-links';

/**
 * One route for both pillar hubs and topic hubs, because both sit one segment
 * under /pwi/ and Astro cannot tell two same-shape dynamic routes apart.
 *
 * A pillar hub lists its topics. A topic hub lists the language chapters that
 * exist for it. Chapters themselves live one level deeper.
 */

const LANGUAGE_LABEL: Record<string, string> = {
  python: 'Python',
  csharp: 'C#',
  sql: 'SQL',
};

export const getStaticPaths = (async () => {
  const chapters = await getCollection('chapters', ({ data }) => !data.draft && data.section === 'pwi');
  const published = new Set(chapters.map((chapter) => chapter.data.topic));
  const { links: articleLinks } = await loadPwiArticleTopics();

  const pillarPaths = Object.entries(PILLAR_COPY).map(([slug, copy]) => ({
    params: { slug },
    props: {
      kind: 'pillar' as const,
      title: copy.title,
      blurb: copy.blurb,
      topics: publishedTopicsFirst(TOPICS.filter((topic) => topic.pillar === slug), published, articleLinks),
      chapters: [],
      published,
      articleLinks,
    },
  }));

  const topicPaths = TOPICS.filter((topic) => topic.section === 'pwi' &&
    chapters.some((chapter) => chapter.data.topic === topic.slug),
  ).map((topic) => ({
    params: { slug: topic.slug },
    props: {
      kind: 'topic' as const,
      title: topic.title,
      blurb: topic.note ?? '',
      topic,
      topics: [],
      published,
      articleLinks,
      chapters: chapters
        .filter((chapter) => chapter.data.topic === topic.slug)
        .sort((a, b) => (a.data.language ?? '').localeCompare(b.data.language ?? '')),
    },
  }));

  return [...pillarPaths, ...topicPaths];
}) satisfies GetStaticPaths;

const props = Astro.props;
const isTopic = props.kind === 'topic';
// The teaching series has one language-independent reading path.
// Preserve the existing topic URL by forwarding it to that shared hub.
if (isTopic && props.topic.slug === 'validation-exception-handling') {
  return Astro.redirect('/pwi/programming-to-exceptions/', 301);
}
const isExceptionsPillar = !isTopic && Astro.params.slug === 'programming-to-exceptions';
const overview = isTopic
  ? (await getCollection('overviews', ({ data }) => !data.draft))
      .find((entry) => entry.data.topic === props.topic.slug)
  : undefined;
const overviewContent = overview ? await render(overview) : undefined;
const Content = overviewContent?.Content;
const headings = overviewContent?.headings;

// A pillar page shows each published topic as a card; topics still pending stay as a short list.
const topicCards = isTopic ? undefined : await loadTopicCards(props.topics);
const pillarArticles = isTopic ? [] : await loadPwiPillarArticles(Astro.params.slug ?? '');

const description = isTopic
  ? (props.chapters[0]?.data.description ?? props.title)
  : props.blurb;
---

{overview && Content && isTopic ? (
  <ArticleLayout
    headings={headings}
    title={overview.data.title}
    description={overview.data.description}
    datePublished={overview.data.datePublished}
    dateModified={overview.data.dateModified}
    tags={overview.data.tags}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'PWI', href: '/pwi/' }]}
    hero={heroFor(`pwi-${props.topic.slug}`)}
    markdownHref={`/pwi/${props.topic.slug}.md`}
    seed={props.topic.slug}
    evergreen
  >
    <Content />
    <section aria-labelledby="language-chapters-heading">
      <h2 id="language-chapters-heading">Language chapters</h2>
      <ul class="langs">
        {props.chapters.map((chapter) => (
          <li class="lang">
            <a href={`/pwi/${props.topic.slug}/${chapter.data.language}/`} class="lang__link">
              <h3 class="lang__title">{LANGUAGE_LABEL[chapter.data.language ?? ''] ?? chapter.data.language}</h3>
              <p class="lang__blurb">{chapter.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </ArticleLayout>
) : (
<SectionLayout
  title={props.title}
  heading={props.title}
  eyebrow={isTopic ? 'PWI chapter' : 'PWI pillar'}
  description={description}
  seed={props.title}
  heroSlug={`pwi-${Astro.params.slug}`}
  showTagCloud={!isTopic}
>
  {
    isTopic ? (
      <>
        <p class="muted scope">
          {props.topic.scope === 'language-independent'
            ? 'The guidance is language-independent. Implementations differ where the underlying library differs; the concept does not.'
            : `Specific to ${LANGUAGE_LABEL[props.topic.scope] ?? props.topic.scope}.`}
        </p>

        <ul class="langs">
          {props.chapters.map((chapter) => (
            <li class="lang">
              <a href={`/pwi/${props.topic.slug}/${chapter.data.language}/`} class="lang__link">
                <h2 class="lang__title">
                  {LANGUAGE_LABEL[chapter.data.language ?? ''] ?? chapter.data.language}
                </h2>
                <p class="lang__blurb">{chapter.data.description}</p>
              </a>
            </li>
          ))}
        </ul>

        <p class="back"><a href="/pwi/">All of PWI</a></p>
      </>
    ) : (
      <>
        {pillarArticles.length > 0 && (
          <section aria-labelledby="pillar-articles-heading">
            <h2 id="pillar-articles-heading">Read the articles</h2>
            <p class="muted scope">
              {isExceptionsPillar
                ? 'Start with Part 1, then continue to Part 2. The concepts apply across languages; the worked examples use C#.'
                : 'Read these in order.'}
            </p>
            <ul class="card-grid cards">
              {pillarArticles.map((article) => (
                <li>
                  <ArticleCard
                    href={`/writing/${article.id}/`}
                    title={article.data.title}
                    description={article.data.description}
                    date={article.data.datePublished}
                    tags={article.data.tags}
                    hero={article.data.hero ? heroFor(article.data.hero) : undefined}
                    markdownHref={`/writing/${article.id}.md`}
                    level={3}
                  />
                </li>
              ))}
            </ul>
          </section>
        )}
        {!isExceptionsPillar && <>
        {pillarArticles.length > 0 && <h2 class="reference-heading">Reference chapters</h2>}
        <p class="muted scope">
          {props.topics.length} topics. Chapter numbers are deliberately absent, because
          the two language families number their chapters independently.
        </p>
        {topicCards && topicCards.cards.length > 0 && (
          <ul class="card-grid cards">
            {topicCards.cards.map((card) => (
              <li>
                <ArticleCard
                  href={card.href}
                  title={card.topic.title}
                  description={card.description}
                  date={card.date}
                  tags={card.tags}
                  hero={card.hero}
                  kicker={card.kicker}
                  markdownHref={card.markdown}
                />
              </li>
            ))}
          </ul>
        )}

        {topicCards && topicCards.pending.length > 0 && (
          <>
            <h2 class="pending-heading">Not yet published</h2>
            <TopicList topics={topicCards.pending} basePath="/pwi/" published={props.published} articleLinks={props.articleLinks} />
          </>
        )}
        </>}
        {isExceptionsPillar && (
          <p class="back">
            Related guidance: <a href="/pwi/method-design/">Method Design</a> and{' '}
            <a href="/writing/gateway-design-pattern/">Gateway Design</a>.
          </p>
        )}
        <p class="back"><a href="/pwi/">All of PWI</a></p>
      </>
    )
  }
</SectionLayout>
)}

<style>
  .scope { font-size: var(--step--1); max-width: var(--measure); }

  .langs {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0 0;
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .lang {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .lang__link { display: block; padding: var(--space-m); text-decoration: none; color: inherit; height: 100%; }
  .lang__link:hover .lang__title { color: var(--color-accent); }
  .lang__title { font-size: var(--step-1); margin-bottom: var(--space-2xs); }
  .lang__blurb { margin: 0; font-size: var(--step--1); color: var(--color-text-muted); }

  .back { margin-top: var(--space-l); font-size: var(--step--1); }
  .cards { margin-top: var(--space-m); }
  .reference-heading { margin-top: var(--space-xl); }
  .pending-heading { margin-top: var(--space-xl); font-size: var(--step-1); }
</style>
