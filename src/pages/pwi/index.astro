---
import SectionLayout from '../../layouts/SectionLayout.astro';
import TopicList from '../../components/TopicList.astro';
import SectionCard from '../../components/SectionCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { heroFor } from '../../lib/heroes';
import { PILLARS } from '../../data/nav';
import { topicsInSection } from '../../data/topics';
import { getCollection } from 'astro:content';
import { loadPwiArticleTopics, publishedTopicsFirst } from '../../lib/pwi-topic-links';

const topics = topicsInSection('pwi');

// Each pillar's art: its own hero, or the Acceptance Testing banner for Verification with Intent,
// which is that section.
const pillarHero = (href: string) =>
  heroFor(href.startsWith('/pwi/') ? `pwi-${href.split('/')[2] ?? ''}` : 'section-acceptance-testing');

const chapterTopics = new Set(
  (await getCollection('chapters', ({ data }) => !data.draft && data.section === 'pwi'))
    .map((chapter) => chapter.data.topic),
);

const { articles: designPatternArticles, links: articleLinks } = await loadPwiArticleTopics();
const orderedTopics = publishedTopicsFirst(topics, chapterTopics, articleLinks);

---

<SectionLayout
  title="PWI"
  heading="Programming With Intent"
  eyebrow="Operationalized guidance"
  description="Four pillars covering how code is structured, written, verified, and how it fails. Each rule is specific enough to apply the same way twice."
  seed="pwi"
  heroSlug="section-pwi"
  showTagCloud={true}
>
  <section class="prose">
    <p>
      Programming With Intent began as a long-running video series. The chapters below
      carry that material as text, with worked examples in Python and C#.
    </p>
    <p>
      Guidance is written to be applied rather than admired. Most rules exist because a
      specific class of defect kept recurring, and the chapter says which one.
    </p>
    <p>
      Recurring phrases run through the chapters, and their canonical meanings live in
      the <a href="/pwi/aphorisms/">Aphorism Glossary</a>. Each definition lists the
      chapters that invoke it.
    </p>
    <p>
      One of the four pillars sits in the top-level navigation in its own right.
      Verification with Intent is
      <a href="/acceptance-testing/">Acceptance Testing</a>, promoted because functional
      acceptance testing at the boundary is the practice that earns confidence to ship.
      Its chapters live there rather than being copied here.
    </p>
  </section>

  <section class="pillars" aria-labelledby="pillars-heading">
    <h2 id="pillars-heading">The four pillars</h2>

    <ul class="card-grid card-grid--compact">
      {
        PILLARS.map((pillar) => (
          <li>
            <SectionCard href={pillar.href} title={pillar.label} blurb={pillar.blurb} hero={pillarHero(pillar.href)} icon={pillar.icon} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="topics-section" aria-labelledby="design-patterns-heading">
    <h2 id="design-patterns-heading">Design patterns</h2>
    <p class="muted topics-section__note">
      Factories, configuration and service boundaries explained through their
      responsibilities and worked examples. <a href="/tags/design-patterns/">Browse all design pattern articles</a>.
    </p>
    <ul class="card-grid">
      {designPatternArticles.map((article) => (
        <li>
          <ArticleCard
            href={`/writing/${article.id}/`}
            title={article.data.title}
            description={article.data.description}
            date={article.data.datePublished}
            tags={article.data.tags}
            hero={article.data.hero ? heroFor(article.data.hero) : undefined}
            markdownHref={`/writing/${article.id}.md`}
            level={3}
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="topics-section" aria-labelledby="topics-heading">
    <h2 id="topics-heading">All topics</h2>
    <p class="muted topics-section__note">
      {topics.length} topics. Chapter numbers are deliberately absent, because the two
      language families number their chapters independently.
    </p>

    <TopicList topics={orderedTopics} basePath="/pwi/" published={chapterTopics} articleLinks={articleLinks} />
  </section>
</SectionLayout>

<style>
  .pillars {
    margin-top: var(--space-xl);
  }

  .card-grid--compact {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .topics-section {
    margin-top: var(--space-2xl);
  }

  .topics-section__note {
    font-size: var(--step--1);
    max-width: var(--measure);
  }
</style>
