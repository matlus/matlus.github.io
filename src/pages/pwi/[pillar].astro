---
import type { GetStaticPaths } from 'astro';
import SectionLayout from '../../layouts/SectionLayout.astro';
import TopicList from '../../components/TopicList.astro';
import { TOPICS } from '../../data/topics';
import { PILLAR_COPY } from '../../data/pillars';

/**
 * One page per pillar, built from the topic registry.
 *
 * Verification with Intent is absent by design; see src/data/pillars.ts.
 */

export const getStaticPaths = (() =>
  Object.entries(PILLAR_COPY).map(([slug, copy]) => ({
    params: { pillar: slug },
    props: {
      copy,
      topics: TOPICS.filter((topic) => topic.pillar === slug),
    },
  }))) satisfies GetStaticPaths;

const { copy, topics } = Astro.props;
---

<SectionLayout
  title={copy.title}
  heading={copy.title}
  eyebrow="PWI pillar"
  description={copy.blurb}
  seed={copy.title}
  showTagCloud={true}
>
  <p class="muted count">
    {topics.length} topics. Chapter numbers are deliberately absent, because the two
    language families number their chapters independently.
  </p>

  <TopicList topics={topics} basePath="/pwi/" />

  <p class="back"><a href="/pwi/">All of PWI</a></p>
</SectionLayout>

<style>
  .count { font-size: var(--step--1); max-width: var(--measure); }
  .back { margin-top: var(--space-l); font-size: var(--step--1); }
</style>
