---
import SectionLayout from '../../layouts/SectionLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { mediaEntries, hasAudio, hasVideo } from '../../data/media';
import { heroFor } from '../../lib/heroes';

const entries = await mediaEntries();

const videoCount = entries.filter(hasVideo).length;
const audioCount = entries.filter(hasAudio).length;
---

<SectionLayout
  title="Media"
  heading="Video and Audio"
  eyebrow="Watch and listen"
  description="Every article with a video or an audio companion. Each card opens the article, and the video and audio boxes go straight to the recording."
  seed="media"
  heroSlug="section-media"
>
  <section class="prose">
    <p>
      Articles are the canonical pages. Where one has a recorded version or an audio
      companion, it appears here so you can browse the media directly rather than opening
      every chapter to find out which ones have it.
    </p>
  </section>

  <div class="media-toolbar" role="group" aria-label="Filter by media type">
    <button type="button" class="filter is-active" data-filter="all">
      All <span class="filter__count">{entries.length}</span>
    </button>
    <button type="button" class="filter" data-filter="video">
      Video <span class="filter__count">{videoCount}</span>
    </button>
    {audioCount > 0 && (
      <button type="button" class="filter" data-filter="audio">
        Audio <span class="filter__count">{audioCount}</span>
      </button>
    )}
  </div>

  <ul class="card-grid media-list">
    {
      entries.map((entry) => (
        <li
          data-has-video={hasVideo(entry) ? 'true' : 'false'}
          data-has-audio={hasAudio(entry) ? 'true' : 'false'}
        >
          <ArticleCard
            href={entry.href}
            title={entry.title}
            description={entry.description}
            date={entry.published}
            tags={entry.tags}
            hero={entry.hero ? heroFor(entry.hero) : undefined}
            kicker={entry.section}
            markdownHref={entry.markdown}
            videos={[
              ...(entry.video
                ? [{ url: entry.video, label: entry.title, kind: entry.videoLabel ?? 'Video on YouTube' }]
                : []),
              ...entry.additionalVideos.map((video) => ({
                url: video.url,
                label: video.label,
                kind: 'Video on YouTube',
              })),
            ]}
            audio={entry.audio ? { url: entry.audio, label: entry.title, kind: 'Audio' } : undefined}
          />
        </li>
      ))
    }
  </ul>

  <p class="empty" hidden>Nothing matches that filter.</p>
</SectionLayout>

<style>
  .media-toolbar {
    display: flex;
    gap: var(--space-2xs);
    margin: var(--space-m) 0;
    flex-wrap: wrap;
  }

  .filter {
    font: inherit;
    font-size: var(--step--1);
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .filter:hover {
    color: var(--color-text);
    border-color: var(--color-text-faint);
  }

  .filter.is-active {
    background: var(--color-accent-wash);
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .filter__count {
    opacity: 0.7;
    margin-left: 0.15em;
  }

  .empty {
    margin-top: var(--space-m);
    color: var(--color-text-muted);
  }
</style>

<script>
  const toolbar = document.querySelector<HTMLElement>('.media-toolbar');
  const items = [...document.querySelectorAll<HTMLLIElement>('.media-list > li')];
  const empty = document.querySelector<HTMLParagraphElement>('.empty');

  toolbar?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter');
    if (!button) return;

    const filter = button.dataset['filter'] ?? 'all';

    for (const other of toolbar.querySelectorAll('.filter')) {
      other.classList.toggle('is-active', other === button);
    }

    let visible = 0;
    for (const item of items) {
      const show =
        filter === 'all' ||
        (filter === 'video' && item.dataset['hasVideo'] === 'true') ||
        (filter === 'audio' && item.dataset['hasAudio'] === 'true');

      item.hidden = !show;
      if (show) visible += 1;
    }

    if (empty) empty.hidden = visible > 0;
  });
</script>
