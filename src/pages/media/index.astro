---
import SectionLayout from '../../layouts/SectionLayout.astro';
import { MEDIA, hasAudio, hasVideo } from '../../data/media';

const entries = [...MEDIA].sort((a, b) => (b.published ?? '').localeCompare(a.published ?? ''));

const videoCount = entries.filter(hasVideo).length;
const audioCount = entries.filter(hasAudio).length;
---

<SectionLayout
  title="Media"
  heading="Video and Audio"
  eyebrow="Watch and listen"
  description="Everything that has a video or an audio companion, in one table. Titles link back to the article, which is where both live."
  seed="media"
>
  <section class="prose">
    <p>
      Articles are the canonical pages. Where one has a recorded version or an audio
      companion, it appears here so you can browse the media directly rather than opening
      every chapter to find out which ones have it.
    </p>
    <p class="muted">
      Placeholder rows. Once content exists this table is generated at build time from
      the same frontmatter that renders the players on each article.
    </p>
  </section>

  <div class="media-toolbar" role="group" aria-label="Filter by media type">
    <button type="button" class="filter is-active" data-filter="all">
      All <span class="filter__count">{entries.length}</span>
    </button>
    <button type="button" class="filter" data-filter="video">
      Video <span class="filter__count">{videoCount}</span>
    </button>
    <button type="button" class="filter" data-filter="audio">
      Audio <span class="filter__count">{audioCount}</span>
    </button>
  </div>

  <table class="media-table">
    <caption class="visually-hidden">
      Articles with video or audio, newest first
    </caption>
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Section</th>
        <th scope="col" class="col-media">Video</th>
        <th scope="col" class="col-media">Audio</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map((entry) => (
          <tr
            data-has-video={hasVideo(entry) ? 'true' : 'false'}
            data-has-audio={hasAudio(entry) ? 'true' : 'false'}
          >
            <th scope="row">
              <a href={entry.href}>{entry.title}</a>
            </th>
            <td class="muted">{entry.section}</td>
            <td class="col-media">
              {entry.video ? (
                <a href={entry.video} rel="noopener">
                  Watch
                </a>
              ) : (
                <span class="absent" aria-label="No video">
                  &mdash;
                </span>
              )}
            </td>
            <td class="col-media">
              {entry.audio ? (
                <a href={entry.audio} download>
                  Listen
                </a>
              ) : (
                <span class="absent" aria-label="No audio">
                  &mdash;
                </span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p class="empty" hidden>Nothing matches that filter.</p>
</SectionLayout>

<style>
  .media-toolbar {
    display: flex;
    gap: var(--space-2xs);
    margin-bottom: var(--space-m);
    flex-wrap: wrap;
  }

  .filter {
    font: inherit;
    font-size: var(--step--1);
    padding: var(--space-3xs) var(--space-xs);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .filter:hover {
    color: var(--color-text);
    border-color: var(--color-text-faint);
  }

  .filter.is-active {
    background: var(--color-accent-wash);
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .filter__count {
    opacity: 0.7;
    margin-left: 0.15em;
  }

  .media-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .media-table th,
  .media-table td {
    text-align: left;
    padding: var(--space-xs) var(--space-2xs);
    border-bottom: 1px solid var(--color-border);
    vertical-align: baseline;
  }

  .media-table thead th {
    font-family: var(--font-sans);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    color: var(--color-text-faint);
    border-bottom-color: var(--color-border-strong);
  }

  .media-table tbody th {
    font-weight: 500;
    font-family: var(--font-sans);
  }

  .media-table tbody th a {
    text-decoration: none;
    color: var(--color-text);
  }

  .media-table tbody th a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .col-media {
    width: 6rem;
    white-space: nowrap;
  }

  .absent {
    color: var(--color-text-faint);
  }

  .empty {
    margin-top: var(--space-m);
    color: var(--color-text-muted);
  }

  @media (max-width: 560px) {
    .media-table td:nth-child(2) {
      display: none;
    }
    .media-table thead th:nth-child(2) {
      display: none;
    }
  }
</style>

<script>
  const toolbar = document.querySelector<HTMLElement>('.media-toolbar');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.media-table tbody tr')];
  const empty = document.querySelector<HTMLParagraphElement>('.empty');

  toolbar?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter');
    if (!button) return;

    const filter = button.dataset['filter'] ?? 'all';

    for (const other of toolbar.querySelectorAll('.filter')) {
      other.classList.toggle('is-active', other === button);
    }

    let visible = 0;
    for (const row of rows) {
      const show =
        filter === 'all' ||
        (filter === 'video' && row.dataset['hasVideo'] === 'true') ||
        (filter === 'audio' && row.dataset['hasAudio'] === 'true');

      row.hidden = !show;
      if (show) visible += 1;
    }

    if (empty) empty.hidden = visible > 0;
  });
</script>
