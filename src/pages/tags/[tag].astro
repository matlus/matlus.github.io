---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SectionLayout from '../../layouts/SectionLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { TAGS } from '../../data/tags';
import { heroFor } from '../../lib/heroes';

/**
 * One pre-built page per tag.
 *
 * These are real HTML files on disk, generated at build time, not a
 * client-side filter. A crawler arriving at /tags/verification/ finds content
 * rather than an empty shell, which is why the static pages exist alongside
 * any interactive filtering.
 */
export const getStaticPaths = (async () => {
  // Declared here rather than in frontmatter: Astro extracts getStaticPaths
  // into a separate module, where frontmatter consts are out of scope.
  const LANG: Record<string, string> = { python: 'Python', csharp: 'C#', sql: 'SQL' };

  const posts = await getCollection('writing', ({ data }) => !data.draft);
  const chapters = await getCollection('chapters', ({ data }) => !data.draft);
  const overviews = await getCollection('overviews', ({ data }) => !data.draft);

  /*
   * A tag page lists everything carrying the tag, articles and chapters alike.
   * Leaving chapters out made 12 published chapters invisible to every topic
   * page, and left tags that only chapters use looking empty.
   */
  const entries = [
    ...overviews.map((overview) => ({
      title: overview.data.title,
      description: overview.data.description,
      href: `/pwi/${overview.data.topic}/`,
      tags: overview.data.tags as readonly string[],
      date: overview.data.datePublished,
      hero: overview.data.hero,
      markdown: `/pwi/${overview.data.topic}.md`,
      kind: 'PWI',
    })),
    ...posts.map((post) => ({
      title: post.data.title,
      description: post.data.description,
      href: `/writing/${post.id}/`,
      tags: post.data.tags as readonly string[],
      date: post.data.datePublished,
      hero: post.data.hero,
      markdown: `/writing/${post.id}.md`,
      kind: 'Writing',
    })),
    ...chapters.map((chapter) => ({
      title: `${chapter.data.title} in ${LANG[chapter.data.language ?? ''] ?? ''}`.trim(),
      description: chapter.data.description,
      href: `/${chapter.data.section}/${chapter.data.topic}/${chapter.data.language ?? 'shared'}/`,
      tags: chapter.data.tags as readonly string[],
      date: chapter.data.datePublished,
      hero: chapter.data.hero,
      markdown: `/${chapter.data.section}/${chapter.data.topic}/${chapter.data.language ?? 'shared'}.md`,
      kind: 'Chapter',
    })),
  ];

  return TAGS.filter((tag) => tag.slug !== 'factory-method').map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tag,
      posts: entries
        .filter((entry) => entry.tags.includes(tag.slug))
        .sort((a, b) => b.date.getTime() - a.date.getTime()),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;

---

<SectionLayout
  title={tag.label}
  heading={tag.label}
  eyebrow="Topic"
  description={tag.description}
  seed={`tag-${tag.slug}`}
  heroSlug={`tag-${tag.slug}`}
>
  <p class="muted count">{posts.length} {posts.length === 1 ? 'page' : 'pages'}</p>

  <ul class="card-grid">
    {
      posts.map((post) => (
        <li>
          <ArticleCard
            href={post.href}
            title={post.title}
            description={post.description}
            date={post.date}
            hero={post.hero ? heroFor(post.hero) : undefined}
            kicker={post.kind}
            markdownHref={post.markdown}
          />
        </li>
      ))
    }
  </ul>

  {posts.length === 0 && <p class="muted">Nothing carries this tag yet.</p>}

  <p class="back"><a href="/tags/">All topics</a></p>
</SectionLayout>

<style>
  .count { font-size: var(--step--1); }
  .card-grid { margin-top: var(--space-m); }
  .back { margin-top: var(--space-l); font-size: var(--step--1); }
</style>
