---
import SectionLayout from '../../layouts/SectionLayout.astro';
---

<SectionLayout
  title="Videos"
  description="Written companions to the YouTube material, cross-linked to their sources."
  eyebrow="From the channel"
  seed="videos"
  showTagCloud={true}
>
  <section class="prose">
    <p>
      Much of this material started as video. These pages carry the same content as text
      so it can be read, searched, quoted, and linked to a specific section.
    </p>
    <p>
      Each page links to the video it came from, and each video description links back
      here.
    </p>
    <p class="muted">Transcription is under way. Nothing published yet.</p>
  </section>
</SectionLayout>
