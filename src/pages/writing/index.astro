---
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { heroFor } from '../../lib/heroes';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);
---

<SectionLayout
  title="Writing"
  description="Essays on building software, and on building it alongside language models."
  eyebrow="Essays"
  seed="writing"
  heroSlug="section-writing"
  showTagCloud={true}
>
  <ul class="card-grid">
    {
      posts.map((post) => (
        <li>
          <ArticleCard
            href={`/writing/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.datePublished}
            tags={post.data.tags}
            hero={post.data.hero ? heroFor(post.data.hero) : undefined}
            status={post.data.status}
            markdownHref={`/writing/${post.id}.md`}
          />
        </li>
      ))
    }
  </ul>

  {posts.length === 0 && <p class="muted">Nothing published yet.</p>}
</SectionLayout>
