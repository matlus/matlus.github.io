---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleFeed from '../components/ArticleFeed.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((left, right) =>
  Math.max(right.data.datePublished.getTime(), right.data.dateModified?.getTime() ?? 0) -
  Math.max(left.data.datePublished.getTime(), left.data.dateModified?.getTime() ?? 0) ||
  right.data.datePublished.getTime() - left.data.datePublished.getTime() ||
  left.data.title.localeCompare(right.data.title),
);
---

<BaseLayout
  title="Shiv Kumar"
  description="Shiv Kumar writes about software engineering, applied AI engineering, Programming With Intent, and acceptance testing."
  isHome={true}
>
  <header class="page home-intro">
    <h1>Software Engineering and <span class="gradient-text">Applied AI Engineering</span></h1>
    <p class="muted">Articles by Shiv Kumar on software architecture, programming, acceptance testing, and building with language models.</p>
  </header>
  <section class="page latest" aria-labelledby="latest-articles-heading">
    <h2 id="latest-articles-heading">Latest articles</h2>
    <p class="muted">New and updated articles, most recent first.</p>
    <ArticleFeed posts={posts} />
  </section>
</BaseLayout>

<style>
  .home-intro { padding-top: var(--space-l); }
  .home-intro h1 { max-width: var(--measure); margin-bottom: var(--space-s); }
  .home-intro p { max-width: var(--measure); }
  .latest { margin-top: var(--space-l); }
  .latest > h2 { font-size: var(--step-2); }
</style>
