---
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import TopicList from '../../components/TopicList.astro';
import { topicsInSection } from '../../data/topics';
import { acceptanceSeries } from '../../data/acceptance-series';

const topics = topicsInSection('acceptance-testing');

const chapterTopics = new Set(
  (await getCollection('chapters', ({ data }) => !data.draft)).map((chapter) => chapter.data.topic),
);

const headline = topics.find(
  (topic) => topic.slug === 'functional-acceptance-testing' && chapterTopics.has(topic.slug),
);
const rest = topics.filter((topic) => topic.slug !== 'functional-acceptance-testing');
---

<SectionLayout
  title="Acceptance Testing"
  heading="Functional Acceptance Testing at the Boundary"
  eyebrow="Acceptance Testing"
  description="A sixteen-part guide to functional acceptance testing: complete scenarios, real infrastructure, deep assertions, maintained regression protection, and confidence to release."
  seed="acceptance-testing"
  heroSlug="section-acceptance-testing"
  showTagCloud={true}
>
  <section class="prose">
    <p>
      Functional acceptance tests invoke the assembled system through its public
      operation and verify everything the scenario requires. Correct arrangements,
      independent observations, and complete comparisons give a green result its meaning.
    </p>
    <p>
      This series follows one order through its caller result, database records,
      fulfillment message, and confirmation. It then covers scenario completeness,
      failure states, concurrency, interface testing, maintenance, and release readiness.
    </p>
  </section>

  <section class="prose coverage" aria-labelledby="series-heading">
    <h2 id="series-heading">Read the series</h2>
    <p>Start with the boundary and its purpose, then follow the worked examples in order.</p>
    <ol class="series-list">
      {acceptanceSeries.map((article) => (
        <li>
          <a href={`/writing/${article.slug}/`}>{article.title}</a>
          <p class="muted">{article.description}</p>
        </li>
      ))}
    </ol>
  </section>

  {
    headline && (
      <section class="headline">
        <a href={`/acceptance-testing/${headline.slug}/`} class="headline__link">
          <p class="eyebrow">Foundational chapters</p>
          <h2 class="headline__title">{headline.title}</h2>
          <p class="headline__blurb">
            Store-derived expectations, pinned-scenario guards, bounded selection, and
            collision-proof identities.
          </p>
        </a>
      </section>
    )
  }

  <section class="topics-section" aria-labelledby="topics-heading">
    <h2 id="topics-heading">The surrounding discipline</h2>
    <p class="muted topics-section__note">
      Strategy, structure, naming, and assertions. These carry examples in both
      languages.
    </p>

    <TopicList topics={rest} basePath="/acceptance-testing/" published={chapterTopics} />
  </section>

  <section class="prose coverage">
    <h2>A note on C# coverage</h2>
    <p>
      Python has a dedicated chapter for functional acceptance testing. C# does not yet.
      On the C# side the same ground is covered inside
      {chapterTopics.has('service-boundary-testing') ? (
        <a href="/acceptance-testing/service-boundary-testing/">Service-Boundary Testing</a>
      ) : (
        'Service-Boundary Testing'
      )}, which includes domain-boundary functional acceptance tests.
    </p>
    <p class="muted">
      The guidance itself is language-independent. Only the worked examples differ.
    </p>
  </section>
</SectionLayout>

<style>
  .series-list li { margin-bottom: var(--space-m); }
  .series-list p { margin-top: var(--space-2xs); font-size: var(--step--1); }
  .headline {
    margin-top: var(--space-xl);
  }

  .headline__link {
    display: block;
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-accent-wash);
    text-decoration: none;
    color: inherit;
  }

  .headline__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-2xs);
  }

  .headline__link:hover .headline__title {
    color: var(--color-accent);
  }

  .headline__blurb {
    margin: 0;
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  .topics-section {
    margin-top: var(--space-2xl);
  }

  .topics-section__note {
    font-size: var(--step--1);
    max-width: var(--measure);
  }

  .coverage {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }

  .coverage h2 {
    font-size: var(--step-1);
  }
</style>
