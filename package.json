{
  "name": "matlus.github.io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node tools/check-card-images.mjs && node tools/check-preview-images.mjs && astro build && node tools/set-built-image-dimensions.mjs dist && node tools/check-built-card-images.mjs dist && node tools/check-built-previews.mjs dist && pagefind --site dist && node tools/check-search.mjs dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:links": "node --experimental-strip-types --test tools/external-links.test.mjs",
    "test:feed": "node --experimental-strip-types --test tools/homepage-posts.test.mjs",
    "test:images": "node --test tools/check-card-images.test.mjs",
    "test:previews": "node --test tools/check-preview-images.test.mjs tools/check-built-previews.test.mjs tools/set-built-image-dimensions.test.mjs",
    "test:feedback": "node --test workers/feedback/test/*.test.mjs",
    "audit:copy": "python tools/audit-copy.py",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.3",
    "parse5": "8.0.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
